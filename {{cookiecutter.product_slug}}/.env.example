MCP_HOST=0.0.0.0
MCP_PORT=8000
# Container worker processes. Local `make run` stays on one process because reload cannot use workers.
MCP_WORKERS=1
MCP_LOG_LEVEL=INFO
# json: one JSON object per line for CloudWatch Logs Insights and Splunk
# console: single-line text for a local terminal
MCP_LOG_FORMAT=console
# Health probes stay at DEBUG unless this is true.
MCP_LOG_HEALTH=false
MCP_AUTH_REQUIRED=false
